# =============================================================
# 天津仁爱学院报销系统 · Nginx 反向代理配置（模板）
#
# 本文件是模板，不要直接启用。用 deploy.sh 生成实际配置：
#   sudo bash deploy/deploy.sh --port 18080
#   sudo bash deploy/deploy.sh --domain reimburse.example.com
# 渲染脚本会把下面两个占位符替换掉：
#   __DOMAIN__      访问用的域名；IP 直访时为 _
#   __HTTP_PORT__   对外监听端口；独立端口部署时如 18080，域名部署时为 80
#
# 两种输出形态：
#   A 独立端口（--no-https）：只留 HTTP server，直接反代到后端
#   B 域名 HTTPS：80 跳 443 + 443 终结 TLS 后反代
# 形态 B 的 443 块引用了 certbot 证书，签发前会被脚本剔除，
# 否则 nginx -t 会因证书文件不存在而直接失败。
#
# 为什么必须走 Nginx：
#   1) 应用只监听 127.0.0.1:5180，公网不可直达
#   2) 由 Nginx 统一做 TLS 终结与上传体积限制
#   3) Basic Auth 由应用层做，此处不重复（两层鉴权出问题时更难排查）
# =============================================================

upstream reimburse_backend {
    server 127.0.0.1:5180;
    keepalive 16;
}

server {
    listen __HTTP_PORT__;
    listen [::]:__HTTP_PORT__;
    server_name __DOMAIN__;

    # 财务票据可能是 PDF 或扫描件，上传上限放宽到 20M
    client_max_body_size 20m;
    # 上传 body 走流式，关缓冲避免大文件先落盘临时文件
    proxy_request_buffering off;

    access_log /var/log/nginx/reimburse.access.log;
    error_log  /var/log/nginx/reimburse.error.log warn;

    # 基础安全响应头（HSTS 只在 HTTPS 形态下发，见下）
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # certbot 验证目录必须放行，否则后续签证书会失败
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    # 健康检查独立 location，便于探活（应用层该路径免鉴权）
    location = /api/health {
        proxy_pass       http://reimburse_backend;
        proxy_set_header Host $host;
        access_log off;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    # ---- TLS 证书（certbot 签发后路径如下）----
    # 未配 HTTPS 时整块会被渲染脚本剔除，避免 nginx -t 失败
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    client_max_body_size 20m;
    proxy_request_buffering off;

    access_log /var/log/nginx/reimburse.access.log;
    error_log  /var/log/nginx/reimburse.error.log warn;

    location / {
        proxy_pass         http://reimburse_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Basic Auth 依赖 Authorization 头，显式透传防止被上游配置吞掉
        proxy_set_header Authorization     $http_authorization;

        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        # 导出件下载直接透传，不缓冲
        proxy_buffering off;
    }

    location = /api/health {
        proxy_pass       http://reimburse_backend;
        proxy_set_header Host $host;
        access_log off;
    }
}
